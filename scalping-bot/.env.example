# ============================================================================
#  Copier ce fichier en ".env" puis le remplir :   cp .env.example .env && chmod 600 .env
#  .env est ignoré par git : NE JAMAIS le committer ni le partager.
#  Les variables FREQTRADE__SECTION__CLE remplacent les valeurs de config.json.
# ============================================================================

# --- Binance (clé "lecture + trading spot", SANS retrait, restreinte à l'IP du serveur) ---
# Laisser vide pendant le dry-run : le bot n'en a pas besoin pour le paper trading.
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# --- Telegram (bot créé avec @BotFather, chat_id obtenu via @userinfobot) ---
FREQTRADE__TELEGRAM__ENABLED=true
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=

# --- FreqUI / API (générer avec : openssl rand -hex 32) ---
FREQTRADE__API_SERVER__USERNAME=freqtrader
FREQTRADE__API_SERVER__PASSWORD=
FREQTRADE__API_SERVER__JWT_SECRET_KEY=
FREQTRADE__API_SERVER__WS_TOKEN=

# --- Verrou du mode réel -----------------------------------------------------
# Même avec "dry_run": false dans config.json, la stratégie REFUSE toute entrée
# tant que cette ligne n'est pas décommentée avec exactement cette valeur.
# NE PAS mettre FREQTRADE__DRY_RUN ici : le mode se change à la main dans config.json.
# CONFIRM_LIVE_TRADING=OUI_JE_COMPRENDS_LES_RISQUES
