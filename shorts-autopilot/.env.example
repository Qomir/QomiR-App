# Copiez ce fichier en .env et remplissez-le. .env n'est JAMAIS versionné (voir .gitignore).

# test = génère sans publier (output/review/) · live = publie réellement
MODE=test
# Niche active : tech_ai_en | tech_ia_fr | business_en | finance_en (fichiers de config/niches/)
NICHE=tech_ai_en

# ── LLM (gratuit) ── clé sur https://aistudio.google.com/apikey (palier gratuit, sans carte)
GEMINI_API_KEY=
# Optionnel : LLM local. Avec le profil docker "ollama" : http://ollama:11434
OLLAMA_HOST=
OLLAMA_MODEL=

# ── B-roll (gratuit) ── https://www.pexels.com/api/ et https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ── Telegram ── bot créé via @BotFather ; chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── YouTube ── identifiants OAuth « Application de bureau » (Google Cloud Console)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ── TikTok ── app sur https://developers.tiktok.com (l'URI doit être celle déclarée dans l'app)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# ── Instagram ── jeton longue durée généré dans le tableau de bord Meta (prolongé automatiquement)
INSTAGRAM_ACCESS_TOKEN=
